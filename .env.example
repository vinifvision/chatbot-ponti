# Copie este arquivo para ".env" e preencha com os dados do provedor de LLM.

LLM_API_KEY=cole_sua_chave_aqui

# Google Gemini (tem plano gratuito). Criei a chave no Google AI Studio.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash

# Se der erro de conexão, rode: python testar_llm.py
# Ele mostra quais modelos a sua chave enxerga e o erro exato do provedor.
